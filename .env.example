# =========================================================================
# e-CBT Environment Variables Template
# =========================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit '.env' to version control.

# -------------------------------------------------------------------------
# Appwrite Backend Configuration
# -------------------------------------------------------------------------

# The URL endpoint of your Appwrite server/cloud (e.g., https://cloud.appwrite.io/v1)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# The Project ID of your Appwrite project
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# The secret API Key generated from Appwrite Console.
# Must have scopes for: users (read, write) and databases (read, write, collections, attributes, documents).
NEXT_APPWRITE_KEY=your_appwrite_api_key_secret
