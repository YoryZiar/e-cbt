# =========================================================================
# e-CBT Environment Variables Template
# =========================================================================
# Copy this file to '.env' or '.env.local' and fill in your actual credentials.
# Do NOT commit secrets to version control.

# Database URL for Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT Secret Token for authentication
JWT_SECRET=super_secret_key_change_me_later_or_keep_it_secure_12345
